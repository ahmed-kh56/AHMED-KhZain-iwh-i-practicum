doctype html
html
  head
    title= title
  body
    h1 Add or Update Custom Object
    form(action="/update-cobj", method="POST")
      label(for="name") Name:
      input(type="text", name="name", required)
      br
      label(for="type") Type:
      input(type="text", name="type", required)
      br
      label(for="age") Age:
      input(type="number", name="age", required)
      br
      button(type="submit") Submit
